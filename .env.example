# Copy this file to .env.local for Next.js, and copy backend/.env.example
# to backend/.env. Use the exact same JWT_SECRET value in both files.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Set in Vercel to your Render API origin (no /api suffix). This configures
# same-origin rewrites for production browser requests and session cookies.
BACKEND_API_URL=
JWT_SECRET=

# Optional: credentials for the demo login.
DEMO_EMAIL=admin@northstar.io
DEMO_PASSWORD=northstar-demo-2026

# Optional: still used by the retained ULTRON chat endpoint.
# Required for conversational AI. Use a trusted OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: cap total characters accepted per chat request.
CHAT_MAX_INPUT_CHARS=12000
